# Dockerfile for Remote-Profile Application
FROM nginx:alpine

# Remove default nginx config
RUN rm -rf /usr/share/nginx/html/*

# Copy pre-built remote-profile application
COPY dist/remote-profile /usr/share/nginx/html

# Copy nginx configuration
COPY nginx-remote.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
